    <script>
        const carousel = document.getElementById('carousel');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const resetBtn = document.getElementById('resetBtn');
        const slideIndicator = document.getElementById('slideIndicator');

        const exerciseSlides = 6;
        const totalSlides = 7;
        const storageKey = 'knee-exercise-set-counts';
        const setCounts = loadSetCounts();
        let currentSlide = 0;

        function loadSetCounts() {
            const saved = localStorage.getItem(storageKey);
            if (!saved) {
                return Array(exerciseSlides).fill(0);
            }

            try {
                const parsed = JSON.parse(saved);
                if (Array.isArray(parsed) && parsed.length === exerciseSlides) {
                    return parsed.map(value => Number.isFinite(Number(value)) ? Number(value) : 0);
                }
            } catch {
                return Array(exerciseSlides).fill(0);
            }

            return Array(exerciseSlides).fill(0);
        }

        function saveSetCounts() {
            localStorage.setItem(storageKey, JSON.stringify(setCounts));
        }

        function updateSetCount(slideIndex) {
            const countElements = document.querySelectorAll(`[data-set-count="${slideIndex}"]`);
            countElements.forEach(element => {
                element.textContent = setCounts[slideIndex];
            });

            const decrementButtons = document.querySelectorAll(`[data-set-decrement="${slideIndex}"]`);
            decrementButtons.forEach(button => {
                button.disabled = setCounts[slideIndex] === 0;
            });

            saveSetCounts();
        }

        function updateAllSetCounts() {
            for (let i = 0; i < exerciseSlides; i++) {
                updateSetCount(i);
            }
        }

        function updateCarousel() {
            carousel.style.transform = `translateX(-${currentSlide * 100}%)`;
            slideIndicator.textContent = `${currentSlide + 1} / ${totalSlides}`;
            prevBtn.disabled = currentSlide === 0;
            nextBtn.disabled = currentSlide === totalSlides - 1;
        }

        function resetAllCounters() {
            for (let i = 0; i < exerciseSlides; i++) {
                setCounts[i] = 0;
            }

            updateAllSetCounts();
            currentSlide = 0;
            updateCarousel();
        }

        nextBtn.addEventListener('click', () => {
            if (currentSlide < totalSlides - 1) {
                currentSlide++;
                updateCarousel();
            }
        });

        prevBtn.addEventListener('click', () => {
            if (currentSlide > 0) {
                currentSlide--;
                updateCarousel();
            }
        });

        resetBtn.addEventListener('click', resetAllCounters);

        document.querySelectorAll('[data-set-increment]').forEach(button => {
            button.addEventListener('click', () => {
                const slideIndex = Number(button.getAttribute('data-set-increment'));
                setCounts[slideIndex]++;
                updateSetCount(slideIndex);
            });
        });

        document.querySelectorAll('[data-set-decrement]').forEach(button => {
            button.addEventListener('click', () => {
                const slideIndex = Number(button.getAttribute('data-set-decrement'));
                if (setCounts[slideIndex] > 0) {
                    setCounts[slideIndex]--;
                    updateSetCount(slideIndex);
                }
            });
        });

        updateAllSetCounts();
        updateCarousel();
    </script>
