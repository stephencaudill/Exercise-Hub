            <div class="flex justify-between items-center p-4 bg-gray-50 border-t border-gray-200">
                <button id="prevBtn" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                    &larr; Previous
                </button>
                <span id="slideIndicator" class="text-gray-600 font-medium">1 / 7</span>
                <button id="nextBtn" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">
                    Next &rarr;
                </button>
            </div>
